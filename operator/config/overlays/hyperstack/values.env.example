# Copy this file to values.env and fill in your Hyperstack details.
# values.env is gitignored — never commit it.
#
# 1. Create the API-key secret (never put the key in an arg or in git):
#      kubectl create secret generic hyperstack-api \
#        --from-literal=api-key=$HYPERSTACK_API_KEY \
#        -n operator-system
#
# 2. Apply your cluster ID to the overlay:
#      sed -i "s/YOUR_CLUSTER_ID/$HYPERSTACK_CLUSTER_ID/g" \
#        config/overlays/hyperstack/manager_args_patch.yaml
#
# 3. Deploy:
#      kubectl apply -k config/overlays/hyperstack

HYPERSTACK_API_KEY=your-hyperstack-api-key
HYPERSTACK_CLUSTER_ID=your-numeric-cluster-id
